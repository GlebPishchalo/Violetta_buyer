generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContentBlock {
  key     String  @id // "hero_title" (без суффикса локали)
  valueRu String
  valueEn String?
}

model Shop {
  id            String   @id @default(cuid())
  name          String
  url           String
  category      String // ключ: "luxury" | "marketplace" | "shoes" | ...
  descriptionRu String?
  descriptionEn String?
  image         String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  name      String
  city      String?
  telegram  String?
  text      String
  rating    Int
  status    String   @default("pending")
  locale    String   @default("ru")
  createdAt DateTime @default(now())
}

model Flight {
  id        String   @id @default(cuid())
  date      DateTime
  direction String // "DXB-MOW" | "MOW-DXB"
  noteRu    String?
  noteEn    String?
}

model Admin {
  id           String @id @default(cuid())
  login        String @unique
  passwordHash String
}
